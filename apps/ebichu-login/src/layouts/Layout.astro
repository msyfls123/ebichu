---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Ebichu</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
  }

  main {
    width: min(22rem, 90vw);
    padding: 2rem 0;
  }

  h1 {
    font-size: 1.5rem;
    margin-block-end: 1.5rem;
  }

  form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  input {
    padding: 0.6rem 0.7rem;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  button {
    padding: 0.65rem;
    border: 0;
    border-radius: 0.5rem;
    background: #3b82f6;
    color: white;
    font: inherit;
    cursor: pointer;
  }

  button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  [data-error] {
    color: #dc2626;
    font-size: 0.9rem;
    margin: 0;
  }

  a {
    color: #3b82f6;
  }
</style>
