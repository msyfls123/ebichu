{
  "name": "ebichu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:login": "pnpm --filter @ebichu-cc/login dev",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "release:version": "node scripts/next-version.mjs packages/ebichu-auth/package.json @ebichu-cc/auth"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
